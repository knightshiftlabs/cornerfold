{
  "name": "cornerfold",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "1.13.0",
  "type": "module",
  "scripts": {
    "changelog": "node scripts/changelog.mjs",
    "dev": "node scripts/changelog.mjs && node scripts/licenses.mjs && vite",
    "build": "node scripts/changelog.mjs && node scripts/licenses.mjs && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:fuzz": "vitest run --config vitest.fuzz.config.ts",
    "test:e2e": "npm run build && playwright test --project=desktop --project=phone",
    "preversion": "npm test && npm run build",
    "version": "node scripts/stamp-date.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource/caveat": "5.3.0",
    "@neslinesli93/qpdf-wasm": "0.3.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "preact": "^10.29.8",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@napi-rs/canvas": "^0.1.65",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.12",
    "jpeg-js": "^0.4.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "overrides": {
    "playwright": "1.64.1",
    "playwright-core": "1.64.1"
  }
}
